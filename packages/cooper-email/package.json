{
  "name": "cooper-email",
  "version": "0.2.0",
  "description": "Official TypeScript SDK and agent setup CLI for Cooper Email \u2014 HTTP email for AI agents (cooperemail.com). Run `npx cooper-email setup`.",
  "license": "MIT",
  "author": "Avatar 8 LLC <ops@avatar33.com>",
  "homepage": "https://github.com/cooper-email/cooper-email/tree/main/packages/cooper-email#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cooper-email/cooper-email.git",
    "directory": "packages/cooper-email"
  },
  "bugs": {
    "url": "https://github.com/cooper-email/cooper-email/issues"
  },
  "keywords": [
    "cooper-email",
    "email",
    "agents",
    "mcp",
    "inbox",
    "cli",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "agent-skills"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cooper-email": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync": "node scripts/sync-skill.mjs",
    "prebuild": "node scripts/sync-skill.mjs",
    "build": "tsup",
    "test": "vitest run --config ../../vitest.config.ts test"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.0"
  }
}
